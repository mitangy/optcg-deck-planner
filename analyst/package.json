{
  "name": "@optcg/analyst",
  "private": true,
  "version": "0.1.0",
  "description": "Log Pose: deck analyst tools served over MCP (Claude custom connector)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-official": "tsx scripts/check-official.ts",
    "eval": "tsx evals/qa/run.ts",
    "eval:compare": "tsx evals/qa/compare.ts",
    "eval:review-facts": "tsx evals/review-facts/run.ts",
    "eval:deck-advice": "tsx evals/deck-advice/run.ts",
    "eval:puzzles": "tsx evals/puzzles/run.ts",
    "eval:check-live": "tsx evals/qa/check-live.ts",
    "eval:grade": "tsx evals/qa/grade-human.ts",
    "eval:grade-export": "tsx evals/qa/grade-export.ts",
    "eval:grade-import": "tsx evals/qa/grade-import.ts",
    "eval:judge-agreement": "tsx evals/qa/judge-agreement.ts",
    "eval:validate": "tsx evals/qa/validate.ts",
    "upload-bot-games": "tsx scripts/upload-bot-games.ts",
    "bot-lessons": "tsx scripts/bot-lessons.ts",
    "feedback-cases": "tsx scripts/feedback-cases.ts",
    "meta-decks": "tsx scripts/meta-decks.ts",
    "human-bot-games": "tsx scripts/human-bot-games.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@optcg/analyst-contract": "*",
    "@optcg/card-core": "*",
    "@optcg/deck-analytics": "*",
    "@optcg/price-timing": "*",
    "@optcg/rules": "*",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "~5.7.2",
    "vitest": "^5.1.0"
  }
}
