{
  "name": "@optcg/game-server",
  "private": true,
  "version": "0.1.0",
  "description": "Authoritative Colyseus duel runtime (Step 2)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --include ../packages/rules/src/cards/**/*.ts --include ../packages/rules/src/engine.ts --include ../packages/rules/src/index.ts --include ../packages/rules/src/types.ts --include ../packages/rules/src/rng.ts src/index.ts",
    "start": "tsx src/index.ts",
    "test": "mocha --import=tsx/esm \"test/**/*.test.ts\" --exit --timeout 60000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.43",
    "@colyseus/tools": "^0.18.11",
    "@optcg/duel-protocol": "*",
    "@optcg/rules": "*",
    "@types/pg": "^8.23.1",
    "colyseus": "^0.18.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@colyseus/testing": "^0.18.6",
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "mocha": "^11.7.5",
    "typescript": "~5.7.2"
  }
}
