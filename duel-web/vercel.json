{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npx vite build",
  "ignoreCommand": "bash ../scripts/vercel-ignore-build.sh duel-web packages/deck-analytics packages/site-legal packages/patch-notes packages/ui packages/rules packages/analyst-client scripts/seo scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://optcg-api-nutb.onrender.com/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-optcg-proxy-secret"
          },
          "args": "$PROXY_SHARED_SECRET",
          "env": [
            "PROXY_SHARED_SECRET"
          ]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/index\\.html",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/play-one-piece-tcg-online/?",
      "dest": "/play-one-piece-tcg-online/index.html"
    },
    {
      "src": "/optcg-sim-online/?",
      "dest": "/optcg-sim-online/index.html"
    },
    {
      "src": "/play-optcg-on-phone/?",
      "dest": "/play-optcg-on-phone/index.html"
    },
    {
      "src": "/leaders/?",
      "dest": "/leaders/index.html"
    },
    {
      "src": "/leaders/([^/]+?)/?",
      "dest": "/leaders/$1/index.html",
      "check": true
    },
    {
      "src": "/leaders/[^/]+(?:/index\\.html)?/?",
      "dest": "/_app.html"
    },
    {
      "src": "/watch/[^/]+/?",
      "dest": "/_app.html"
    },
    {
      "src": "/decks/?",
      "dest": "/_app.html"
    },
    {
      "src": "/decks/meta/?",
      "dest": "/decks/meta/index.html"
    },
    {
      "src": "/decks/new/?",
      "dest": "/_app.html"
    },
    {
      "src": "/decks/[^/]+/configure/?",
      "dest": "/_app.html"
    },
    {
      "src": "/decks/configure/?",
      "dest": "/_app.html"
    },
    {
      "src": "/duel/?",
      "dest": "/_app.html"
    },
    {
      "src": "/hotseat/?",
      "dest": "/_app.html"
    },
    {
      "src": "/settings/?",
      "dest": "/_app.html"
    },
    {
      "src": "/leaderboard/?",
      "dest": "/leaderboard/index.html"
    },
    {
      "src": "/history/?",
      "dest": "/_app.html"
    },
    {
      "src": "/history/[^/]+/?",
      "dest": "/_app.html"
    },
    {
      "src": "/replay/[^/]+/?",
      "dest": "/_app.html"
    },
    {
      "src": "/admin/?",
      "dest": "/_app.html"
    },
    {
      "src": "/auth/complete/?",
      "dest": "/_app.html"
    },
    {
      "src": "/welcome/username/?",
      "dest": "/_app.html"
    },
    {
      "src": "/demo/?",
      "dest": "/_app.html"
    },
    {
      "src": "/whats-new/?",
      "dest": "/whats-new/index.html"
    },
    {
      "src": "/events/[^/]+/rules/?",
      "dest": "/_app.html"
    },
    {
      "src": "/terms/?",
      "dest": "/terms/index.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/cookies/?",
      "dest": "/cookies/index.html"
    },
    {
      "src": "/conduct/?",
      "dest": "/conduct/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/_app.html",
      "status": 404
    }
  ]
}
