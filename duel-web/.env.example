# Colyseus HTTP(S) endpoint; SDK derives WS/WSS.
VITE_GAME_SERVER_URL=http://127.0.0.1:2567
# FastAPI for /duel/dev-token and ratings
VITE_API_URL=http://127.0.0.1:8000
# Optional — must match game-server DEV_JOIN_SECRET when set
# VITE_DEV_JOIN_SECRET=
# Legal gate (ADR-008): set false on public builds to hide official names/art
# VITE_SHOW_OFFICIAL_IDENTITY=true
