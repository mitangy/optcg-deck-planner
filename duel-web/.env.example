# Colyseus HTTP(S) endpoint; SDK derives WS/WSS.
VITE_GAME_SERVER_URL=http://localhost:2567
# FastAPI for /duel/* tokens, ratings, and OAuth.
# Must use the SAME hostname as backend BACKEND_PUBLIC_URL (both localhost or
# both 127.0.0.1). Mixing them drops the OAuth nonce cookie → "Invalid OAuth state".
VITE_API_URL=http://localhost:8000
# Optional — must match game-server DEV_JOIN_SECRET when set
# VITE_DEV_JOIN_SECRET=
# Legal gate (ADR-008): set false on public builds to hide official names/art
# VITE_SHOW_OFFICIAL_IDENTITY=true
