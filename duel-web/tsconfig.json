{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@optcg/deck-analytics": ["../packages/deck-analytics/src/index.ts"],
      "@optcg/deck-analytics/*": ["../packages/deck-analytics/src/*"],
      "@optcg/site-legal": ["../packages/site-legal/src/index.ts"],
      "@optcg/site-legal/*": ["../packages/site-legal/src/*"],
      "@optcg/patch-notes": ["../packages/patch-notes/src/index.ts"],
      "@optcg/patch-notes/*": ["../packages/patch-notes/src/*"],
      "@optcg/rules/*": ["../packages/rules/src/*"],
      "@optcg/analyst-client": ["../packages/analyst-client/src/index.ts"],
      "@optcg/analyst-client/*": ["../packages/analyst-client/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
