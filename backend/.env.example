# Local: SQLite. Production (Neon): postgresql://USER:PASS@HOST/db?sslmode=require
DATABASE_URL=sqlite:///./optcg.db
SESSION_SECRET=dev-secret-change-me
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
ALLOWED_EMAILS=
ALLOW_ANY_GOOGLE_USER=true
ENABLE_DEV_LOGIN=true
CATALOG_SYNC_TOKEN=dev-sync-token
# Shared with game-server for Colyseus join tokens (defaults to SESSION_SECRET if empty)
GAME_TOKEN_SECRET=
# Game-server match result ingest (header X-Duel-Ingest-Token)
DUEL_INGEST_SECRET=dev-duel-ingest
# Extra CORS origins for Expo web / future duel-web (comma-separated)
DUEL_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
