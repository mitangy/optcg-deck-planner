{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@optcg/deck-analytics": ["../packages/deck-analytics/src/index.ts"],
      "@optcg/deck-analytics/*": ["../packages/deck-analytics/src/*"],
      "@optcg/site-legal": ["../packages/site-legal/src/index.ts"],
      "@optcg/site-legal/*": ["../packages/site-legal/src/*"],
      "@optcg/analyst-client": ["../packages/analyst-client/src/index.ts"],
      "@optcg/analyst-client/*": ["../packages/analyst-client/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src"]
}
