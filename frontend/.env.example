# Optional. Local dev already defaults to same-host:8000 (see src/api.ts),
# which follows whatever host you loaded the page from — localhost or a LAN
# IP alike, so phone testing over LAN works without touching this file. Only
# set this if you need the frontend to hit a *different* backend than the one
# on this machine, e.g. a shared staging API. Production uses same-origin
# /api via the Vercel proxy when VITE_API_URL is unset, so leave it unset on Vercel.
# VITE_API_URL=http://localhost:8000

# Optional. Origin of the duel app used by the "Play in Duel" button.
# VITE_DUEL_URL=https://optcgduel.app
