{
  "name": "@optcg/rules",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/sim/optcgsim": "./src/sim/optcgsim/index.ts",
    "./src/*": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/cli/runBatch.ts",
    "replay:record": "tsx src/cli/replayCli.ts record",
    "replay:bless": "tsx src/cli/replayCli.ts bless",
    "fuzz:smoke": "tsx src/sim/fuzzSmoke.ts",
    "fuzz": "tsx src/sim/fuzz.ts",
    "sim-import:report": "tsx src/sim/optcgsim/report.ts",
    "selfplay": "tsx src/sim/selfPlay.ts",
    "fit-value": "tsx src/sim/fitValue.ts",
    "export-deck-prior": "tsx src/cli/exportDeckPrior.ts",
    "bench:views": "tsx src/cli/benchViews.ts",
    "goldfish": "tsx src/sim/goldfish.ts",
    "export-atlas": "tsx src/cli/exportAtlas.ts",
    "export-planner-stats": "tsx src/cli/exportPlannerStats.ts",
    "export-protocol-fixtures": "tsx src/cli/exportProtocolFixtures.ts",
    "scenario-coverage": "tsx src/cli/scenarioCoverage.ts",
    "lint:programs": "tsx src/cli/lintPrograms.ts",
    "mutation:stryker": "stryker run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@optcg/card-core": "*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^5.1.0"
  }
}
