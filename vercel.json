{
  "framework": "vite",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "cd frontend && npx vite build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh frontend packages/deck-analytics packages/site-legal packages/patch-notes packages/analyst-client packages/ui vercel.json scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://optcg-api-nutb.onrender.com/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-optcg-proxy-secret"
          },
          "args": "$PROXY_SHARED_SECRET",
          "env": [
            "PROXY_SHARED_SECRET"
          ]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/index\\.html",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/login/?",
      "dest": "/index.html"
    },
    {
      "src": "/share/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/meta/?",
      "dest": "/index.html"
    },
    {
      "src": "/group-buy/join/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/group-buy/view/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/whats-new/?",
      "dest": "/index.html"
    },
    {
      "src": "/terms/?",
      "dest": "/index.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/index.html"
    },
    {
      "src": "/cookies/?",
      "dest": "/index.html"
    },
    {
      "src": "/decks/?",
      "dest": "/index.html"
    },
    {
      "src": "/decks/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/collection/?",
      "dest": "/index.html"
    },
    {
      "src": "/friends/?",
      "dest": "/index.html"
    },
    {
      "src": "/friends/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/friends/[^/]+/decks/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/group-buys/?",
      "dest": "/index.html"
    },
    {
      "src": "/group-buys/[^/]+/?",
      "dest": "/index.html"
    },
    {
      "src": "/import/?",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 404
    }
  ]
}
