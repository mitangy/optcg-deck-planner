{
  "framework": "vite",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "cd frontend && npx vite build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh frontend packages/deck-analytics packages/site-legal packages/patch-notes packages/analyst-client duel-web/src/cards/previewArt.json duel-web/src/cards/previewArtAlts.json vercel.json scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://optcg-api-nutb.onrender.com/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-optcg-proxy-secret"
          },
          "args": "$PROXY_SHARED_SECRET",
          "env": [
            "PROXY_SHARED_SECRET"
          ]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
